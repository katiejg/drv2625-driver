&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    drv2625: drv2625@5a{
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x5a >;
        label = "DRV2625";
    };
};

&pinctrl {
	/omit-if-no-ref/ i2c1_default: i2c1_default {
		group1  {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
			<NRF_PSEL(TWIM_SDA, 1, 2)>;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ i2c1_sleep: i2c1_sleep {
		group1  {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
			<NRF_PSEL(TWIM_SDA, 1, 2)>;
			low-power-enable;
		};
	};
};

/ {
	drv_switch: drv_switch {
		compatible = "drv-switch";
		gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
	};
};
